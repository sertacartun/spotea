__pycache__/
*.pyc
.venv/
venv/
.env
.pytest_cache/
data/*.db
# SQLite's WAL sidecars, left next to the db by the running app.
data/*.db-wal
data/*.db-shm
data/*.db.bak-*
data/storage/*
!data/storage/.gitkeep
data/avatars/*
!data/avatars/.gitkeep
data/thumbnails/*
!data/thumbnails/.gitkeep
data/.cache/
.claude/

# Sandbox/home-dir artifacts, not part of the app
.bash_profile
.bashrc
.gitconfig
.gitmodules
.idea
.mcp.json
.profile
.ripgreprc
.serena/
.vscode
.zprofile
.zshrc

# StyleSeed. The skill install and everything the resolver regenerates from
# STYLESEED.md + .styleseed/project.json + .styleseed/artifacts/ stays out;
# those three are the decisions and are tracked. Same call as .claude/ above:
# agent tooling is not application code.
.agents/
skills-lock.json
.styleseed/bundles/
.styleseed/manifests/
.styleseed/palettes/
.styleseed/palette.json
.styleseed/palette.css
# Screenshots and a screen recording — 8.8MB of evidence that is reproducible
# by re-running the app, and does not belong in the history.
.styleseed/studio/*/evidence/
