{
  "schemaVersion": 1,
  "id": "refresh-progress",
  "target": {
    "kind": "component",
    "locator": "app/templates/index.html"
  },
  "selection": {
    "grammar": "consumer-service",
    "adapter": null,
    "domain": null,
    "page": "none",
    "recipe": null,
    "palette": null,
    "profile": null,
    "fallback": "consumer-service"
  },
  "decisions": {
    "primaryDecision": "Refresh reports real progress from the server; it must never imply work that is not happening.",
    "primaryAction": "Watch the release check finish, or dismiss it.",
    "signatureMove": "Progress is stated in items checked, not a spinner with no end."
  },
  "implementation": {
    "sourceRoots": [
      "app/templates",
      "app/static/css",
      "app/static/js"
    ],
    "tokenFiles": [
      "app/static/css/style.css"
    ]
  },
  "validation": {
    "scoreFloor": 80,
    "requiredRenders": [
      {
        "id": "mobile-loading",
        "state": "loading",
        "viewport": {
          "width": 390,
          "height": 844
        }
      },
      {
        "id": "mobile-error",
        "state": "error",
        "viewport": {
          "width": 390,
          "height": 844
        }
      },
      {
        "id": "desktop-loaded",
        "state": "loaded",
        "viewport": {
          "width": 1440,
          "height": 1000
        }
      }
    ],
    "temporal": {
      "required": true,
      "scenarios": []
    },
    "humanAcceptance": true
  }
}
