{
  "schemaVersion": 1,
  "id": "library",
  "target": {
    "kind": "component",
    "locator": "app/templates/_library_grid.html"
  },
  "selection": {
    "grammar": "consumer-service",
    "adapter": null,
    "domain": null,
    "page": "list",
    "recipe": null,
    "palette": null,
    "profile": null,
    "fallback": "consumer-service"
  },
  "decisions": {
    "primaryDecision": "The library is a small set of durable tiles plus hand-made playlists, not an infinite feed.",
    "primaryAction": "Open a tile or a hand-made playlist.",
    "signatureMove": "Four fixed meaning-tiles read as one row of kinds, with Downloads carrying the only offline-valid state."
  },
  "implementation": {
    "sourceRoots": [
      "app/templates",
      "app/static/css",
      "app/static/js"
    ],
    "tokenFiles": [
      "app/static/css/style.css"
    ]
  },
  "validation": {
    "scoreFloor": 80,
    "requiredRenders": [
      {
        "id": "mobile-loaded",
        "state": "loaded",
        "viewport": {
          "width": 390,
          "height": 844
        }
      },
      {
        "id": "mobile-empty",
        "state": "empty",
        "viewport": {
          "width": 390,
          "height": 844
        }
      },
      {
        "id": "desktop-loaded",
        "state": "loaded",
        "viewport": {
          "width": 1440,
          "height": 1000
        }
      }
    ],
    "temporal": {
      "required": false,
      "scenarios": []
    },
    "humanAcceptance": true
  }
}
