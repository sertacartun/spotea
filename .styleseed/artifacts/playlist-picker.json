{
  "schemaVersion": 1,
  "id": "playlist-picker",
  "target": {
    "kind": "component",
    "locator": "app/templates/index.html"
  },
  "selection": {
    "grammar": "consumer-service",
    "adapter": null,
    "domain": null,
    "page": "form",
    "recipe": null,
    "palette": null,
    "profile": null,
    "fallback": "consumer-service"
  },
  "decisions": {
    "primaryDecision": "Adding a track to a playlist is a fast, interruptible choice, not a page.",
    "primaryAction": "Add the track to a playlist, or create one.",
    "signatureMove": "A sheet that opens over the current context and returns focus exactly where it was cancelled."
  },
  "implementation": {
    "sourceRoots": [
      "app/templates",
      "app/static/css",
      "app/static/js"
    ],
    "tokenFiles": [
      "app/static/css/style.css"
    ]
  },
  "validation": {
    "scoreFloor": 80,
    "requiredRenders": [
      {
        "id": "mobile-loaded",
        "state": "loaded",
        "viewport": {
          "width": 390,
          "height": 844
        }
      },
      {
        "id": "mobile-empty",
        "state": "empty",
        "viewport": {
          "width": 390,
          "height": 844
        }
      },
      {
        "id": "desktop-loaded",
        "state": "loaded",
        "viewport": {
          "width": 1440,
          "height": 1000
        }
      }
    ],
    "temporal": {
      "required": true,
      "scenarios": []
    },
    "humanAcceptance": true
  }
}
