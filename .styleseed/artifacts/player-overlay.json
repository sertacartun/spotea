{
  "schemaVersion": 1,
  "id": "player-overlay",
  "target": {
    "kind": "component",
    "locator": "app/templates/_player_overlay.html"
  },
  "selection": {
    "grammar": "consumer-service",
    "adapter": null,
    "domain": null,
    "page": "detail",
    "recipe": null,
    "palette": null,
    "profile": null,
    "fallback": "consumer-service"
  },
  "decisions": {
    "primaryDecision": "The full player is the longest-looked-at surface and must not regress iOS playback behaviour.",
    "primaryAction": "Control playback: play/pause, seek, next, queue, lyrics.",
    "signatureMove": "Expanding the mini player keeps the artwork continuous into the full overlay instead of cross-fading two screens."
  },
  "implementation": {
    "sourceRoots": [
      "app/templates",
      "app/static/css",
      "app/static/js"
    ],
    "tokenFiles": [
      "app/static/css/style.css"
    ]
  },
  "validation": {
    "scoreFloor": 80,
    "requiredRenders": [
      {
        "id": "mobile-loaded",
        "state": "loaded",
        "viewport": {
          "width": 390,
          "height": 844
        }
      },
      {
        "id": "mobile-reduced",
        "state": "reduced-motion",
        "viewport": {
          "width": 390,
          "height": 844
        }
      },
      {
        "id": "desktop-loaded",
        "state": "loaded",
        "viewport": {
          "width": 1440,
          "height": 1000
        }
      }
    ],
    "temporal": {
      "required": true,
      "scenarios": []
    },
    "humanAcceptance": true
  }
}
