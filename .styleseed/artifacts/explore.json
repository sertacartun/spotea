{
  "schemaVersion": 1,
  "id": "explore",
  "target": {
    "kind": "component",
    "locator": "app/templates/index.html"
  },
  "selection": {
    "grammar": "consumer-service",
    "adapter": null,
    "domain": null,
    "page": "list",
    "recipe": null,
    "palette": null,
    "profile": null,
    "fallback": "consumer-service"
  },
  "decisions": {
    "primaryDecision": "Explore is a music catalogue search, not a video search; results must read as songs and artists.",
    "primaryAction": "Search, or play something from a shelf.",
    "signatureMove": "Search field stays reachable while charts, moods and for-you shelves scroll beneath it."
  },
  "implementation": {
    "sourceRoots": [
      "app/templates",
      "app/static/css",
      "app/static/js"
    ],
    "tokenFiles": [
      "app/static/css/style.css"
    ]
  },
  "validation": {
    "scoreFloor": 80,
    "requiredRenders": [
      {
        "id": "mobile-loaded",
        "state": "loaded",
        "viewport": {
          "width": 390,
          "height": 844
        }
      },
      {
        "id": "mobile-empty",
        "state": "empty",
        "viewport": {
          "width": 390,
          "height": 844
        }
      },
      {
        "id": "mobile-loading",
        "state": "loading",
        "viewport": {
          "width": 390,
          "height": 844
        }
      },
      {
        "id": "desktop-loaded",
        "state": "loaded",
        "viewport": {
          "width": 1440,
          "height": 1000
        }
      }
    ],
    "temporal": {
      "required": false,
      "scenarios": []
    },
    "humanAcceptance": true
  }
}
