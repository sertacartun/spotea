# Optional. Copy this file to .env only to change a default; the app runs without it.


# Secret used to sign session cookies. Leave unset and one is generated on
# first start and kept in data/secret_key. Set it only to supply your own:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#SECRET_KEY=

# SQLAlchemy database URL.
# Inside Docker this points at the mounted volume; for local dev without
# Docker you may prefer a relative path, e.g. sqlite:///./data/spotea.db
DATABASE_URL=sqlite:////app/data/spotea.db

# Directory where downloaded audio files are stored.
# For local dev without Docker, e.g. ./data/storage
STORAGE_DIR=/app/data/storage

# Audio format yt-dlp extracts to. m4a matches YouTube's native audio stream
# for almost every video, so extraction is a fast remux instead of a
# duration-scaled re-encode. Other formats (e.g. mp3) still work but are
# slower to prepare since they require transcoding.
AUDIO_FORMAT=m4a

# Whose YouTube Music charts the Explore tab shows. One or more two-letter
# country codes, comma separated. The default is the English-speaking
# markets: US,GB,CA,AU,IE,NZ. All 69 countries YouTube Music offers are
# valid, as is "ZZ" for its global chart.
#
# Each country contributes exactly one tile — its "Trending 20" playlist.
# The video charts that come back alongside it ("Daily Top Music Videos",
# "Top 100 Music Videos", "Top 100 Live Performances") are dropped: they rank
# songs by their official music video's view count, which is not what this
# app is for.
#
# Worth knowing what the global chart contains before choosing it: it is
# weighted by market size, and measured on 2026-08-21 nine of its top twenty
# artists were Indian playback singers, the top five all of them. There is no
# way to filter that — a chart entry carries no market at all — so naming the
# countries you want is the only mechanism there is.
#
# One request per country, and only when Explore's batch is rebuilt (every 30
# minutes at most), not per page view.
#MUSIC_CHART_COUNTRIES=US,GB,CA,AU,IE,NZ

# Host port docker-compose publishes the app on (container always listens on
# 8000 internally). Only read by docker-compose, not the app itself.
# 127.0.0.1:8000 keeps it off the network, e.g. behind tailscale serve or a
# reverse proxy (see docs/SELF_HOSTING.md).
HOST_PORT=8000

# Send the login cookie over HTTPS only. Turn on once the app is reached
# through an HTTPS URL; over plain HTTP, login then silently fails.
#SESSION_HTTPS_ONLY=true
